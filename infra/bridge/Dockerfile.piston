# ═══════════════════════════════════════════════════════════════════════════════
# DevCapsules Custom Piston — Baked-In Universal Datasets
#
# Extends the official Piston image with:
#   1. Pre-loaded CSV datasets at /piston/datasets/ (read-only)
#   2. Pre-installed Python packages (pandas, numpy) in the Piston runtime
#
# The datasets are copied into each job's sandbox at runtime via the
# run_lab.sh wrapper script (sent by the Cloudflare Worker execution payload).
#
# Build:
#   docker build -t devcapsules-piston:latest -f Dockerfile.piston .
#
# The build context must contain:
#   - apple_global_sales_dataset.csv
#   - spotify-tracks-dataset.csv
#
# These are copied from apps/dashboard/public/ by the build script.
# ═══════════════════════════════════════════════════════════════════════════════

FROM ghcr.io/engineer-man/piston:latest

# ── 1. Create dataset directory INSIDE the Python runtime package ─────────────
# Piston's nsjail sandbox only mounts /piston/packages/ — anything outside
# (like /piston/datasets/) is invisible to job sandboxes.
# Placing CSVs inside the Python 3.10.0 package dir means every Python job
# can access them at /piston/packages/python/3.10.0/datasets/
RUN mkdir -p /piston/packages/python/3.10.0/datasets

# ── 2. Copy universal datasets into the sandbox-visible directory ─────────────
COPY apple_global_sales_dataset.csv /piston/packages/python/3.10.0/datasets/
COPY spotify-tracks-dataset.csv     /piston/packages/python/3.10.0/datasets/

# ── 3. Lock down permissions — read-only for all users ────────────────────────
RUN chmod -R 444 /piston/packages/python/3.10.0/datasets/* && \
    chmod 555 /piston/packages/python/3.10.0/datasets

# ── 4. Verify files are present ──────────────────────────────────────────────
RUN ls -la /piston/packages/python/3.10.0/datasets/ && \
    echo "=== Dataset sizes ===" && \
    wc -l /piston/packages/python/3.10.0/datasets/*.csv
